# 原始采集数据不入库（只 ignore 根目录的，别误伤 app/templates/samples/）
/samples/
!/samples/.gitkeep

# 生成的 voice profile 是个人数据，不入库
/profiles/
!/profiles/.gitkeep

# SQLite 数据库不入库
/data/

# 第三方爬虫子项目（按 README 步骤本地克隆和安装）
/crawlers/zhihu/

# 凭证 / cookie / 环境变量（保留 .env.example 作为模板）
.env
.env.local
.env.*.local
*.cookie
*.session
cookies/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
