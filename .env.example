# Copy to .env and fill in.
# inkprint uses any OpenAI-compatible endpoint via the openai SDK.

# --- Option A: Anthropic (Claude) ---
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# --- Option B: DeepSeek (recommended for Chinese, cheap) ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# --- Option C: OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Optional: enables web-search-grounded compose. The model will autonomously
# call web_search(query) when it needs to verify facts during writing. Get a
# free key at https://tavily.com (1000 searches/month on the free tier).
# Leave empty to fall back to no-search compose.
# TAVILY_API_KEY=tvly-...

# Optional: route LLM API calls through an HTTP/SOCKS proxy. Leave empty
# (default) for direct connections — CN providers like DeepSeek need direct.
# Set this only if you actually need a tunnel, e.g. calling Anthropic from
# inside mainland China:
# LLM_PROXY=socks5://127.0.0.1:7890

# --- Option D: local LiteLLM / Ollama / OpenAI-compatible proxy ---
# LLM_BASE_URL=http://localhost:4000
# LLM_API_KEY=sk-anything
# LLM_MODEL=claude-sonnet-4-5
